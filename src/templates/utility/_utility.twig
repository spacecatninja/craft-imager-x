{% import "_includes/forms" as forms %}

{#
 # Rendered inside Craft 6's CP shell, where this HTML is compiled as a Vue template and
 # Craft 5's cp.css isn't loaded. Uses Craft 6 components (<craft-button>, <craft-callout>)
 # and classes (cp-h2, cp-table, cp-code); the rest is in imagerutility.css.
 #}

<div class="imager-utility">
    <section>
        <h2 class="cp-h2 mb-3">{{ 'Caches'|t('imager-x') }}</h2>

        <div class="imager-utility__prose">
            <p>
                Imager X currently have two caches; <strong>the transforms cache</strong>, where all your transformed images
                are stored, and <strong>the runtime cache</strong>, where images that are downloaded from external filesystems and urls, and temporary files
                created by Imager X, are stored.
            </p>
            <p>
                <strong>Not sure if it's a good idea to clear them?</strong>&nbsp;😬&nbsp;
                Check out <a href="https://imager-x.spacecat.ninja/usage/caching.html">the documentation</a> first.
            </p>
        </div>

        <form id="imager-x-utility-cache" method="post" accept-charset="UTF-8" data-action-url="imager-x/utility/clear-cache" data-queue-url="{{ queueUrl }}">
            {{ csrfInput() }}
            {{ actionInput('imager-x/utility/clear-cache') }}
            {{ hiddenInput('cacheClearType', '') }}

            <table class="cp-table cp-table--auto cp-table--aligned imager-utility__table">
                <thead>
                    <tr>
                        <th scope="col" class="thin">{{ 'Cache'|t('imager-x') }}</th>
                        <th scope="col">{{ 'Path'|t('imager-x') }}</th>
                        <th scope="col" class="thin imager-utility__num">{{ 'Files'|t('imager-x') }}</th>
                        <th scope="col" class="thin imager-utility__num">{{ 'Size'|t('imager-x') }}</th>
                        <th scope="col" class="thin"><span class="sr-only">{{ 'Actions'|t('imager-x') }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for cache in caches %}
                        <tr>
                            <th scope="row" class="thin">{{ cache.name }}</th>
                            <td class="imager-utility__wrap"><code class="cp-code">{{ cache.path }}</code></td>
                            <td class="thin imager-utility__num" data-cache-file-count="{{ cache.handle }}">{{ cache.fileCount }}</td>
                            <td class="thin imager-utility__num" data-cache-file-size="{{ cache.handle }}">{{ cache.size }}</td>
                            <td class="thin imager-utility__actions">
                                <craft-button type="button" size="small" data-cache-clear-btn="{{ cache.handle }}">{{ 'Clear'|t('imager-x') }}</craft-button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="mt-4 flex gap-2 items-center">
                <craft-button type="button" variant="accent" data-cache-clear-btn="all">{{ 'Clear all'|t('imager-x') }}</craft-button>
                <div data-imager-x-cache-status role="status" aria-live="polite"></div>
            </div>
        </form>
    </section>

    {% if isPro %}
        <hr class="my-lg">

        <section>
            <h2 class="cp-h2 mb-3">{{ 'Generate transforms'|t('imager-x') }}</h2>

            <div class="imager-utility__prose">
                <p>
                    You can read more about auto-generation of transforms <a href="https://imager-x.spacecat.ninja/usage/generate.html">in the documentation</a>. ⚙️
                </p>
            </div>

            <form id="imager-x-utility-generate" method="post" accept-charset="UTF-8" data-action-url="imager-x/utility/generate-transforms" data-queue-url="{{ queueUrl }}">
                {{ csrfInput() }}
                {{ actionInput('imager-x/utility/generate-transforms') }}

                <div class="imager-utility__fields">
                    {{ forms.checkboxSelectField({
                        label: 'Choose volumes'|t('imager-x'),
                        name: 'volumes',
                        options: volumeOptions,
                        showAllOption: false,
                    }) }}

                    {{ forms.lightswitchField({
                        name: 'useConfiguredTransforms',
                        label: 'Use configured transforms'|t('imager-x'),
                        instructions: 'Use the transforms configured in imager-x-generate.php for each volume. Disable to pick transforms manually.'|t('imager-x'),
                        on: true,
                    }) }}

                    <div id="imager-x-utility-generate-transforms" hidden>
                        {% if namedTransformsOptions|length %}
                            {{ forms.checkboxSelectField({
                                label: 'Choose transforms'|t('imager-x'),
                                instructions: showDisplayNameInfo ? 'It appears that one or more of your named transforms doesn\'t have a display name. If you add this to your transforms in imager-x-transforms.php, those will be shown instead of the handle.'|t('imager-x') : null,
                                name: 'namedTransforms',
                                options: namedTransformsOptions,
                                showAllOption: false,
                            }) }}
                        {% else %}
                            <craft-callout variant="info" icon="circle-info">
                                {{ 'No named transforms are configured. Add some to imager-x-transforms.php to pick them here.'|t('imager-x') }}
                            </craft-callout>
                        {% endif %}
                    </div>
                </div>

                <div class="mt-4 flex gap-2 items-center">
                    <craft-button type="submit" variant="accent" data-imager-x-generate-btn>{{ 'Generate transforms'|t('imager-x') }}</craft-button>
                    <div data-imager-x-generate-status role="status" aria-live="polite"></div>
                </div>
            </form>
        </section>
    {% endif %}

    <hr class="my-lg">

    <section>
        <h2 class="cp-h2 mb-3">{{ 'Debug information'|t('imager-x') }}</h2>

        <div class="imager-utility__prose">
            <p>
                If you need to <a href="https://github.com/spacecatninja/craft-imager-x/issues/new">submit an issue</a>, please
                provide the following information to speed up the debugging process. 🙏
            </p>
        </div>

        <table class="cp-table cp-table--auto cp-table--aligned imager-utility__table imager-utility__table--kv">
            <tbody>
                {% for info in debugInfo %}
                    <tr>
                        <th scope="row" class="thin">{{ info.label }}</th>
                        <td class="imager-utility__wrap">{{ info.value|raw }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
</div>
